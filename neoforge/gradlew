#!/usr/bin/env sh
set -eu

GRADLE_VERSION="9.2.1"
BASE="${GRADLE_USER_HOME:-$HOME/.gradle}/spellcraft-bootstrap/gradle-${GRADLE_VERSION}"
DIST_DIR="$BASE/gradle-${GRADLE_VERSION}"
ZIP="$BASE/gradle-${GRADLE_VERSION}-bin.zip"
URL="https://services.gradle.org/distributions/gradle-${GRADLE_VERSION}-bin.zip"

if [ ! -x "$DIST_DIR/bin/gradle" ]; then
    mkdir -p "$BASE"
    if [ ! -f "$ZIP" ]; then
        echo "Downloading Gradle $GRADLE_VERSION..." >&2
        if command -v curl >/dev/null 2>&1; then
            curl -fL "$URL" -o "$ZIP"
        elif command -v wget >/dev/null 2>&1; then
            wget -O "$ZIP" "$URL"
        else
            echo "Need curl or wget to bootstrap Gradle." >&2
            exit 1
        fi
    fi
    command -v unzip >/dev/null 2>&1 || { echo "Need unzip to bootstrap Gradle." >&2; exit 1; }
    unzip -q -o "$ZIP" -d "$BASE"
fi

exec "$DIST_DIR/bin/gradle" "$@"
